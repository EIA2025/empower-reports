# ── Copy this to .env for local development ───────────────────────────────────
# On Render: set these in Dashboard → Web Service → Environment

# Supabase Transaction Pooler connection string
# Found in: Supabase Dashboard → Project Settings → Database → Connection string
# Tab: "Transaction pooler"  (port 6543 — NOT session mode port 5432)
# Replace [YOUR-PASSWORD] with your actual database password
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx.pooler.supabase.com:6543/postgres

# Flask session signing key — use a long random string in production
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Optional
FLASK_ENV=development
