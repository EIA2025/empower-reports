# Copy this to .env and fill in your values for local development
# On Render, these are set via the dashboard or render.yaml

# PostgreSQL connection string
# Local example:
DATABASE_URL=postgresql://localhost/empower

# Render free PostgreSQL example (Render gives you this automatically via render.yaml):
# DATABASE_URL=postgresql://empower_user:PASSWORD@HOST/empower

# Flask secret key (used to sign sessions - use a long random string in production)
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Optional: set to "production" on Render
FLASK_ENV=development
